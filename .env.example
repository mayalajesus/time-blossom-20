# Application
# local | qa | production
VITE_APP_ENV=local
VITE_APP_URL=http://localhost:5173
VITE_API_BASE_URL=

# Auth provider for the current environment: local | neon | supabase
VITE_AUTH_PROVIDER=local

# Public browser configuration.
# Production uses Supabase Auth; homologation uses Neon Auth.
# Never place service-role, database or other administrative secrets in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_NEON_AUTH_URL=

# Server-side PostgreSQL configuration.
# Homologation: DATABASE_PROVIDER=neon and DATABASE_ENV=qa
# Production:   DATABASE_PROVIDER=supabase and DATABASE_ENV=production
# Never expose DATABASE_URL through VITE_* variables.
DATABASE_PROVIDER=neon
DATABASE_ENV=qa
DATABASE_URL=
SUPABASE_DATABASE_URL=

# Supabase CLI and Edge Functions (server-side/CLI only).
# SUPABASE_URL and SUPABASE_ANON_KEY are used by Supabase Functions.
# SUPABASE_SERVICE_ROLE_KEY must never be exposed to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

# Trello integration (server-side only).
# Create/manage the Power-Up at https://trello.com/apps/admin.
# The API key identifies the application and may be public, but the token
# grants access to the Trello account and must remain secret.
TRELLO_API_BASE_URL=https://api.trello.com/1
TRELLO_API_KEY=
TRELLO_API_TOKEN=
TRELLO_APP_NAME=Time Blossom

# OAuth 1.0 only. Leave empty when using Trello's key + token authorization.
TRELLO_API_SECRET=

# OAuth callback used by the future Trello authorization flow.
TRELLO_RETURN_URL=http://localhost:5173/integrations/trello/callback

# Optional default resources for QA/manual testing; these are IDs, not secrets.
TRELLO_WORKSPACE_ID=
TRELLO_BOARD_ID=
TRELLO_LIST_ID=
